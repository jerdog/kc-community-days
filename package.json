{
  "name": "communitydays-kc",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "communitydays.info — CommunityDays KC conference site on Cloudflare Workers",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "import:sessionize": "node scripts/import-sessionize.mjs",
    "db:migrate:local": "wrangler d1 migrations apply communitydays --local",
    "db:migrate": "wrangler d1 migrations apply communitydays --remote",
    "test:a11y": "npm run build && node tests/a11y.mjs"
  },
  "devDependencies": {
    "astro": "^7.4.12",
    "axe-core": "^4.14.1",
    "node-html-parser": "^9.0.7",
    "playwright": "^1.63.0",
    "wrangler": "^4.164.0"
  }
}
