---
// Posts JSON to /api/<endpoint> and announces the result in a live region.
// Without JavaScript the form still posts normally to the same endpoint.
const { endpoint, submitLabel = 'Submit', class: cls = 'stack', buttonClass = 'btn', id } = Astro.props;
const statusId = `${id || endpoint}-status`;
---
<form class={cls} data-api={`/api/${endpoint}`} method="post" action={`/api/${endpoint}`} id={id} aria-describedby={statusId}>
  <slot />
  <div class="hp" aria-hidden="true"><label>Leave this empty<input name="website" tabindex="-1" autocomplete="off" /></label></div>
  <div><button class={buttonClass} type="submit">{submitLabel}</button></div>
  <p class="form-status" id={statusId} role="status" aria-live="polite"></p>
</form>
