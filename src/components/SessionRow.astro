---
import Ribbon from './Ribbon.astro';
const { session: s, y, showDay = false, headingLevel = 3 } = Astro.props;
const H = `h${headingLevel}`;
const who = s.speakerList.map((p) => p.name).join(', ');
---
<li class:list={['row', { service: s.service }]} data-day={s.startsAt.slice(0, 10)} data-room={s.room} data-community={s.community?.slug || ''}>
  <time datetime={s.startsAt}>{y.fmtClock(s.startsAt)}<span class="where">{showDay ? `${y.fmtShortDay(s.startsAt)} · ` : ''}{s.room}</span></time>
  <div>
    <H>{s.service ? s.title : <a href={y.link(`/program/${s.slug}/`)}>{s.title}</a>}</H>
    <p>{[s.service ? 'Everyone' : who, `${y.minutes(s)} min`].filter(Boolean).join(' · ')}</p>
  </div>
  <Ribbon community={s.community} y={y} />
</li>
