---
// Speaker badge with one ribbon per community the speaker gave a talk for.
const { speaker, y, link = true, headingLevel = 3, eager = false } = Astro.props;
const communities = y.speakerCommunities(speaker.id);
const H = `h${headingLevel}`;
---
<li class="badge">
  <div class="card">
    <div class="role" aria-hidden="true">SPEAKER</div>
    {speaker.photo ? <img src={speaker.photo} alt="" width="200" height="200" loading={eager ? 'eager' : 'lazy'} /> : <div style="aspect-ratio:1;background:var(--rule)"></div>}
    <div class="who">
      <H>{link ? <a href={y.link(`/speakers/${speaker.slug}/`)}>{speaker.name}</a> : speaker.name}</H>
      {speaker.tagline && <p>{speaker.tagline}</p>}
    </div>
  </div>
  {communities.length > 0 && (
    <ul class="hangs" aria-label="Speaking with">
      {communities.map((c) => <li class="hang" style={`--c:${c.color}`}>{c.name}</li>)}
    </ul>
  )}
</li>
