---
// Layout for /admin pages: not indexed, no public navigation.
import '../styles/site.css';
import '../styles/admin.css';
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · CommunityDays KC admin</title>
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Mona+Sans:wdth,wght@75..125,400..900&family=Atkinson+Hyperlegible+Next:wght@400;700&family=Atkinson+Hyperlegible+Mono:wght@400;700&display=swap" />
  </head>
  <body class="admin">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-top on-dark">
      <div class="in admin-top">
        <a class="mark" href="/admin/">CommunityDays KC <span class="admin-tag">Admin</span></a>
        <slot name="user" />
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
  </body>
</html>
