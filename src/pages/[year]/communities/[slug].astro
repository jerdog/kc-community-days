---
import Community from '../../../views/Community.astro';
import { archives } from '../../../lib/years.js';
export function getStaticPaths() {
  return archives.flatMap((y) => y.communities.map((community) => ({ params: { year: String(y.year), slug: community.slug }, props: { y, community } })));
}
---
<Community y={Astro.props.y} community={Astro.props.community} />
