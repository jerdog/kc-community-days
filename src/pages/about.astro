---
import Base from '../layouts/Base.astro';
import { current, site } from '../lib/years.js';
const { event } = current;
const { team } = site;
---
<Base title="About">
  <header class="page-head on-dark"><div class="in">
    <h1>About</h1>
    <p>{event.description}</p>
  </div></header>
  <section class="sec" aria-labelledby="team-h"><div class="in">
    <div class="sec-h"><h2 id="team-h">The organizers</h2></div>
    <ul class="team">
      {team.map((p) => (
        <li>
          <img src={p.photo} alt="" loading="lazy" width="300" height="300" />
          <h3>{p.url ? <a href={p.url}>{p.name}</a> : p.name}</h3>
          <p>{p.role}</p>
        </li>
      ))}
    </ul>
    <p class="sub" style="margin-top:32px">See the <a href="/communities/">communities</a> that make up {event.name}.</p>
  </div></section>
</Base>
