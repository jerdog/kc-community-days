---
import Base from '../layouts/Base.astro';
import { event, groups, tickets } from '../data/site.js';
import { speakers, sessions } from '../lib/sessionize.js';
const talks = sessions.filter((s) => !s.service).length;
---
<Base>
  <section class="section" style="background:var(--brand);color:var(--brand-ink)">
    <div class="container">
      <h1 style="font-size:clamp(34px,6vw,64px)">Join us for {event.name} {event.year}!</h1>
      <p style="font-size:20px;margin:0 0 4px"><strong>{event.dates.label}</strong> at {event.venue.host}</p>
      <p style="margin:0 0 28px">{event.venue.name}, {event.venue.address}</p>
      <p style="display:flex;gap:12px;flex-wrap:wrap;margin:0">
        <a class="btn" href={event.ticketsUrl}>Tickets from ${tickets.tiers[0].price}</a>
        <a class="btn secondary" href={event.prospectusUrl}>See the Sponsor Prospectus</a>
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <p>{event.tagline} {groups.length} meetup groups, {talks} sessions and {speakers.length} speakers across two days.</p>
      <p><a href="/schedule/">See the schedule</a> · <a href="/speakers/">Meet the speakers</a> · <a href="/about/">About the event</a></p>
    </div>
  </section>
</Base>
