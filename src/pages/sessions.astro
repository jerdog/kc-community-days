---
import Base from '../layouts/Base.astro';
import { event } from '../data/site.js';
import { sessions, speakersOf, groupOf, fmtTime, fmtDay, slug } from '../lib/sessionize.js';
const talks = sessions.filter((s) => !s.service);
---
<Base title="Sessions and Workshops">
  <section class="section"><div class="container">
    <h1>Sessions and Workshops</h1>
    <p class="prose muted">We are excited to present this set of sessions and hands-on workshops for {event.name} {event.year}.</p>
    <div style="display:grid;gap:16px;margin-top:24px">
      {talks.map((s) => (
        <article class="card" id={slug(s.title)} style="scroll-margin-top:16px">
          <h2 style="font-size:20px">{s.title}</h2>
          <p class="muted" style="margin:0 0 12px">
            {speakersOf(s).map((p, i) => <>{i > 0 && ', '}<a href={`/speakers/#${slug(p.name)}`}>{p.name}</a></>)}
            {' · '}{fmtDay(s.startsAt)}, {fmtTime(s.startsAt)} · {s.room}
          </p>
          <div class="prose">{s.description.map((p) => <p>{p}</p>)}</div>
          {groupOf(s) && <span class="tag">{groupOf(s)}</span>}
        </article>
      ))}
    </div>
  </div></section>
</Base>
