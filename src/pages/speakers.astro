---
import Base from '../layouts/Base.astro';
import { speakers, sessionsBySpeaker, slug } from '../lib/sessionize.js';
---
<Base title="Speakers">
  <section class="section"><div class="container">
    <h1>Speakers</h1>
    <div class="grid" style="--min:200px;margin-top:24px">
      {speakers.map((p) => (
        <article class="speaker" id={slug(p.name)} style="scroll-margin-top:16px">
          {p.photo && <img src={p.photo} alt="" width="200" height="200" loading="lazy" />}
          <h2 style="font-size:17px;margin:12px 0 2px">{p.name}</h2>
          <p>{p.tagline}</p>
          <details style="margin-top:8px;font-size:14px">
            <summary>Bio and sessions</summary>
            {p.bio.map((b) => <p>{b}</p>)}
            <ul>{sessionsBySpeaker(p.id).map((s) => <li><a href={`/sessions/#${slug(s.title)}`}>{s.title}</a></li>)}</ul>
          </details>
        </article>
      ))}
    </div>
  </div></section>
</Base>
