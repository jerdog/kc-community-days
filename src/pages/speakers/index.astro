---
import Base from '../../layouts/Base.astro';
import SpeakerBadge from '../../components/SpeakerBadge.astro';
import { event } from '../../lib/site.js';
import { speakers, hasProgram } from '../../lib/sessionize.js';
---
<Base title="Speakers" description={`The ${speakers.length} speakers at ${event.name} ${event.year}.`}>
  <header class="page-head on-dark"><div class="in">
    <h1>Speakers</h1>
    <p>{hasProgram ? `${speakers.length} people from across Kansas City's tech community, listed by first name. The ribbon shows the community each one is speaking with.` : `Speakers for ${event.name} ${event.year} will appear here once they're announced.`}</p>
  </div></header>
  <div class="sec"><div class="in">
    {!hasProgram && <p class="prose"><a href="#signup">Sign up for updates</a> to hear when speakers are announced.</p>}
    <ul class="badges">{speakers.map((p, i) => <SpeakerBadge speaker={p} headingLevel={2} eager={i < 4} />)}</ul>
  </div></div>
</Base>
