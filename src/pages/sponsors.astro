---
import Base from '../layouts/Base.astro';
import Form from '../components/Form.astro';
import { event, sponsors } from '../data/site.js';
---
<Base title="Sponsors">
  <section class="section"><div class="container">
    <h1>Sponsors</h1>
    {sponsors.map((tier) => (
      <section style="margin-block:32px">
        <h2 style="font-size:18px;text-transform:uppercase;letter-spacing:.08em">{tier.tier}</h2>
        <div class="grid" style="--min:220px">
          {tier.items.map((s) => {
            const logo = <img src={s.logo} alt={s.name} style="height:90px;width:100%;object-fit:contain" loading="lazy" />;
            return <div class="card">{s.url ? <a href={s.url}>{logo}</a> : logo}</div>;
          })}
        </div>
      </section>
    ))}
  </div></section>
  <section class="section" style="padding-top:0"><div class="container">
    <h2>Interested in sponsoring {event.name} {event.year}?</h2>
    <p class="prose">Fill out the form below and we will reach out with more information. You can also <a href={event.prospectusUrl}>view the Sponsor Prospectus</a>.</p>
    <Form endpoint="sponsor-inquiry">
      <label>Name<input name="name" required autocomplete="name" /></label>
      <label>Email<input name="email" type="email" required autocomplete="email" /></label>
      <label>Company name<input name="company" required autocomplete="organization" /></label>
      <label>Phone <span class="muted">(optional)</span><input name="phone" type="tel" autocomplete="tel" /></label>
      <label>Anything we should know? <span class="muted">(optional)</span><textarea name="message" rows="4"></textarea></label>
    </Form>
  </div></section>
</Base>
