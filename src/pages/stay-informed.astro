---
import Base from '../layouts/Base.astro';
import Form from '../components/Form.astro';
---
<Base title="Stay Informed">
  <section class="section"><div class="container">
    <h1>Stay Informed</h1>
    <p class="prose">Get an email when tickets, speakers and the schedule for the next CommunityDays KC are announced.</p>
    <Form endpoint="subscribe" submitLabel="Sign up">
      <label>Name<input name="name" autocomplete="name" /></label>
      <label><span>Email <span class="req">(required)</span></span><input name="email" type="email" required autocomplete="email" /></label>
    </Form>
  </div></section>
</Base>
