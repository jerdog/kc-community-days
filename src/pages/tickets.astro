---
import Base from '../layouts/Base.astro';
import { event, tickets } from '../data/site.js';
---
<Base title="Tickets">
  <section class="section"><div class="container">
    <h1>Attend {event.name} {event.year}!</h1>
    <p class="muted">{tickets.note}</p>
    <div class="grid" style="--min:240px;max-width:620px;margin-block:24px">
      {tickets.tiers.map((t) => (
        <div class="card">
          <h2 style="font-size:20px">{t.name}</h2>
          <p style="font:800 44px/1 var(--font-display);margin:0 0 8px">${t.price}</p>
          <p class="muted" style="margin:0">{t.note}</p>
        </div>
      ))}
    </div>
    <a class="btn" href={event.ticketsUrl}>Buy tickets on Tito</a>
    <p class="muted" style="margin-top:24px">See our <a href="/code-of-conduct/#refund-policy">refund policy</a>.</p>
  </div></section>
</Base>
