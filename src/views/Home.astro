---
import Base from '../layouts/Base.astro';
import Fountain from '../components/Fountain.astro';
import Lineup from '../components/Lineup.astro';
import NewTab from '../components/NewTab.astro';
import SessionRow from '../components/SessionRow.astro';
import SpeakerBadge from '../components/SpeakerBadge.astro';
import SponsorBadges from '../components/SponsorBadges.astro';
import SponsorLogos from '../components/SponsorLogos.astro';
import { previous } from '../lib/years.js';

const { y } = Astro.props;
const { event, tickets, features, isPast } = y;

const allDays = y.days();
const firstDay = allDays[0];
const firstHour = firstDay
  ? firstDay.sessions.filter((s) => new Date(s.startsAt) - new Date(firstDay.sessions[0].startsAt) < 60 * 60 * 1000).slice(0, 6)
  : [];

// Featured speakers: one per community, for variety. Falls back to last year's until this year's are selected.
const spk = y.speakers.length ? y : !y.archived && previous?.speakers.length ? previous : null;
const featured = [];
if (spk) {
  const used = new Set();
  for (const t of spk.talks) {
    const sp = t.speakerList[0];
    if (!sp?.photo || !t.community || used.has(t.community.slug) || featured.includes(sp)) continue;
    used.add(t.community.slug);
    featured.push(sp);
    if (featured.length === 4) break;
  }
}
const spons = y.hasSponsors ? y : !y.archived && previous?.hasSponsors ? previous : null;
const heroSponsors = y.sponsors.some((t) => t.hero && t.items.length);
const cfpOpen = !y.archived && !isPast && features.callForSpeakers && event.callForSpeakersUrl;
const ticketsOpen = !y.archived && !isPast && features.registration && event.ticketsUrl && tickets.current;

const presents = y.archived
  ? `The ${y.year} event, archived.`
  : isPast
    ? y.hasProgram ? `Thanks for coming to ${y.year}. The program is below.` : `Thanks for coming to ${y.year}.`
    : event.tagline;
const prevProgram = !y.archived && !y.hasProgram && previous?.hasProgram ? previous : null;
---
<Base y={y} title={y.archived ? `${y.year} archive` : undefined}>
  <section class="hero on-dark" aria-labelledby="hero-h">
    <div class="hero-fountain" aria-hidden="true"><Fountain strokeWidth={0.9} /></div>
    <div class="in">
      <div>
        <p class="when">
          {event.dates.known
            ? <><span><b>{event.dates.days}</b> {event.dates.label}</span>{event.venue?.host && <span><b>at</b> {event.venue.host}, {event.venue.city}</span>}</>
            : <span><b>{y.year}</b> Dates coming soon</span>}
        </p>
        <h1 id="hero-h">CommunityDays <span>KC</span>{y.archived && <span class="hero-year"> {y.year}</span>}</h1>
        <p class="presents">{presents}</p>
        {cfpOpen && (
          <div class="cfp">
            <p><strong>The call for speakers is open.</strong> Share what you know with Kansas City's tech community.</p>
            <NewTab class="btn gold" href={event.callForSpeakersUrl}>Submit a talk</NewTab>
          </div>
        )}
        <Lineup y={y} />
        {heroSponsors && (
          <div class="presented">
            <p class="presented-lab">Presented with support from</p>
            <SponsorLogos y={y} hero size="lg" />
          </div>
        )}
      </div>
      {y.archived ? (
        <div class="attendee">
          <div class="role" aria-hidden="true">ARCHIVE</div>
          <h2>{event.name} {y.year}</h2>
          <p>This is the archived {y.year} event. The current event is on the home page.</p>
          <a class="btn" href="/">Go to the current event</a>
        </div>
      ) : isPast ? (
        <div class="attendee">
          <div class="role" aria-hidden="true">SAVE THE DATE</div>
          <h2>{event.name} {y.nextYear}</h2>
          <p>Dates are coming. Sign up and we'll email you when tickets and the call for speakers open.</p>
          <a class="btn" href="#signup">Get updates</a>
        </div>
      ) : ticketsOpen ? (
        <div class="attendee">
          <div class="role" aria-hidden="true">ATTENDEE</div>
          <p class="price">${tickets.current.price}<small>{tickets.current.name.toLowerCase()}</small></p>
          <p>{tickets.note}{tickets.current.untilLabel && tickets.next && ` $${tickets.next.price} after ${tickets.current.untilLabel}.`}</p>
          <NewTab class="btn" href={event.ticketsUrl}>Get your badge</NewTab>
        </div>
      ) : (
        <div class="attendee">
          <div class="role" aria-hidden="true">SAVE THE DATE</div>
          <h2>{event.name} {y.year}</h2>
          <p>{event.dates.known ? `${event.dates.label}. Tickets go on sale soon.` : 'Dates and tickets are coming. Sign up and we’ll email you when they’re announced.'}</p>
          <a class="btn" href="#signup">Get updates</a>
        </div>
      )}
    </div>
  </section>
  <div class="facts on-dark"><div class="in">
    {y.hasProgram && <><span><b>{y.talks.length}</b> talks</span><span><b>{y.speakers.length}</b> speakers</span><span><b>{y.rooms.length}</b> rooms</span></>}
    {event.dates.known && <span><b>{event.dates.count}</b> {event.dates.count === 1 ? 'day' : 'days'}</span>}
    {event.venue?.name && <span>{event.venue.name} · {event.venue.street}</span>}
  </div></div>

  {y.hasProgram && features.program ? (
    <section class="sec" aria-labelledby="prog-h"><div class="in">
      <div class="prog">
        <div class="prog-side" style="position:static">
          <h2 id="prog-h" style="font-weight:900;font-stretch:118%;font-size:clamp(30px,4vw,44px);letter-spacing:-0.03em;line-height:1">Program</h2>
          <p class="sub">How {firstDay.weekday} {isPast ? 'started' : 'starts'}. The full program filters by day, community and room.</p>
          <a class="lnk" href={y.link('/program/')}>See the full program</a>
        </div>
        <ol class="rows">{firstHour.map((s) => <SessionRow session={s} y={y} />)}</ol>
      </div>
    </div></section>
  ) : !y.archived && (
    <section class="sec" aria-labelledby="soon-h"><div class="in prose">
      <h2 id="soon-h" style="font-size:clamp(30px,4vw,44px);font-weight:900;font-stretch:118%">The program is on its way</h2>
      <p>Talks and speakers for {event.name} {y.year} will appear here once they're selected.</p>
      {prevProgram && <p>Meanwhile, browse <a href={prevProgram.link('/program/')}>the {prevProgram.year} program</a>.</p>}
    </div></section>
  )}

  {features.speakers && featured.length > 0 && (
    <section class="sec" aria-labelledby="spk-h"><div class="in">
      <div class="sec-h">
        <h2 id="spk-h">{spk === y ? 'Speakers' : `${spk.year} speakers`}</h2>
        <a class="lnk" href={spk.link('/speakers/')}>{`All ${spk.speakers.length} ${spk === y ? '' : `${spk.year} `}speakers`}</a>
      </div>
      {spk !== y && <p class="sub" style="margin:-14px 0 26px">Last year's lineup. {y.year} speakers will be announced after talks are selected.</p>}
      <ul class="badges">{featured.map((p) => <SpeakerBadge speaker={p} y={spk} />)}</ul>
    </div></section>
  )}

  {spons && (
    <section class="sec" aria-labelledby="spons-h"><div class="in">
      <div class="sec-h"><h2 id="spons-h">{spons === y ? 'Sponsors' : `${spons.year} sponsors`}</h2>{!y.archived && <a class="lnk" href="/sponsor/">Become a sponsor</a>}</div>
      <p class="sub" style="margin:-14px 0 26px">{spons === y ? `Thank you to the organizations behind ${event.name}${y.archived ? ` ${y.year}` : ''}.` : `Thank you to last year's sponsors. Sponsorship for ${y.year} is open.`}</p>
      <SponsorBadges y={spons} />
    </div></section>
  )}
</Base>
