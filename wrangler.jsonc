{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "communitydays",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  // Admin page (/admin): sign in with GitHub. Set in the dashboard (Settings → Variables
  // and Secrets), not here: secrets GITHUB_CLIENT_SECRET and SESSION_SECRET, and the
  // ADMIN_USERS allowlist (GitHub user IDs or usernames, comma-separated). keep_vars stops
  // deploys from deleting dashboard variables that aren't listed in this file.
  "keep_vars": true,
  "vars": {
    "ADMIN_ORIGIN": "https://communitydays.jerdog.workers.dev",
    "ADMIN_REPO": "jerdog/kc-community-days",
    "ADMIN_BRANCH": "main",
    "ADMIN_DRAFT_BRANCH": "admin-draft",
    "GITHUB_CLIENT_ID": "Ov23lijv58f52CbF23V0",
    "PREVIEW_URL_TEMPLATE": "https://{branch}-communitydays.jerdog.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "communitydays",
      "database_id": "c0437d11-7e80-4971-8581-619058feb54e",
      // Schema changes live in ./migrations as numbered .sql files (0001_..., 0002_...).
      // Wrangler records applied ones in the d1_migrations table, so each runs exactly once.
      // They are applied by `npm run deploy` (the Workers Builds deploy command) before the
      // new code goes live. Workers Builds ignores custom build hooks in this file, which is
      // why the migration step lives in package.json rather than here.
      "migrations_dir": "migrations",
      "migrations_table": "d1_migrations"
    }
  ],
  // Branch previews (Workers Builds runs `npm run deploy:preview` on non-production
  // branches). Previews get their own D1 database so test form submissions never
  // touch production data. Keep this in sync with wrangler.preview-migrations.jsonc.
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "communitydays-preview",
        "database_id": "f34fd501-609e-49ae-bf28-c55d6e2e497f"
      }
    ]
  }
  // Once ready to cut over from Squarespace:
  // "routes": [
  //   { "pattern": "communitydays.info", "custom_domain": true },
  //   { "pattern": "www.communitydays.info", "custom_domain": true }
  // ]
}
