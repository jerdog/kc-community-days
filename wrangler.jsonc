{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "communitydays",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "communitydays",
      "database_id": "c0437d11-7e80-4971-8581-619058feb54e",
      "migrations_dir": "migrations"
    }
  ]
  // Once ready to cut over from Squarespace:
  // "routes": [
  //   { "pattern": "communitydays.info", "custom_domain": true },
  //   { "pattern": "www.communitydays.info", "custom_domain": true }
  // ]
}
