{
  // Only used to apply D1 migrations to the shared preview database
  // (`npm run db:migrate:preview`). Must point at the same database as
  // `previews.d1_databases` in wrangler.jsonc.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "communitydays",
  "d1_databases": [
    {
      "binding": "PREVIEW_DB",
      "database_name": "communitydays-preview",
      "database_id": "f34fd501-609e-49ae-bf28-c55d6e2e497f",
      "migrations_dir": "migrations",
      "migrations_table": "d1_migrations"
    }
  ]
}
